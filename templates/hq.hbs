<form autocomplete="off">
  <header class="hq-header"><div class="hq-title"><span>NUNU / CREW HEADQUARTERS</span><h1>Headquarters</h1>
    <input name="name" aria-label="Headquarters name" value="{{name}}" {{#unless editable}}disabled{{/unless}}>
    </div><div class="hq-picture">
      {{#if s.image}}<img src="{{s.image}}" alt="Headquarters image">{{else}}<div class="image-placeholder"><i class="fas fa-building"></i><span>HQ image</span></div>{{/if}}
      {{#if editable}}<div><button type="button" data-asset-action="image" title="Choose HQ image">Choose image</button>{{#if s.image}}<button type="button" data-asset-action="clear-image" title="Remove image">×</button>{{/if}}</div>{{/if}}
    </div>
  </header>
  <nav class="hq-tabs tabs" data-group="hq" aria-label="Headquarters sections">
    <a class="item" data-tab="info" data-group="hq" tabindex="0">HQ Info</a>
    <a class="item" data-tab="crew" data-group="hq" tabindex="0">Crew</a>
    <a class="item" data-tab="benefits" data-group="hq" tabindex="0">Active Crew Benefits</a>
    <a class="item" data-tab="improvements" data-group="hq" tabindex="0">Improvements & Upgrades</a>
    {{#if showWorkshop}}<a class="item" data-tab="workshop" data-group="hq" tabindex="0">Workshop</a>{{/if}}
    <a class="item" data-tab="activity" data-group="hq" tabindex="0">Recent Activity</a>
  </nav>
  <main class="hq-body">
    {{#if showWorkshop}}<section class="tab nplh-workshop" data-tab="workshop" data-group="hq">
      <h2>Workshop / Project register</h2>
      <p>Record work, not elapsed dates. Current HQ capacity: <strong>{{w.capacity}} projects per session</strong>. One crafting month = {{w.monthDays}} days; one day = 24 hours.</p>
      <div class="workshop-toolbar">{{#if w.canWork}}<button type="button" data-workshop="create">New project</button><button type="button" data-workshop="session">Record work session</button>{{/if}}{{#if w.gm}}<button type="button" data-workshop="settings">Month length</button>{{/if}}</div>
      {{#each w.folders}}
      <details class="workshop-folder" data-workshop-folder="{{id}}" open><summary><i class="fas fa-folder"></i> {{name}} <span>{{projects.length}}</span></summary><div class="workshop-folder-body">
      {{#each projects}}
      <details class="workshop-project" open>
        <summary>{{name}} · {{kind}} · {{status}}{{#unless approved}} · Awaiting GM approval{{/unless}}</summary>
        <article class="workshop-blueprint">
          <header><h3>BLUEPRINT / {{name}}</h3><strong>DV {{dv}}</strong></header>
          <p>{{tech}} · {{skill}} · {{category}} · Item value {{price}} eb{{#if parentId}} · Linked prototype{{/if}}</p>
          {{#if isPrototype}}<div class="workshop-item-slot" {{#if canLinkItem}}data-workshop-drop="{{id}}"{{/if}}>
            <strong>Prototype item</strong><p>Drag and drop an Item here from Items, a character inventory or a compendium.</p>
            {{#if linkedItem}}{{#if linkedItem.available}}<button type="button" class="workshop-item-link" data-workshop="open-item" data-project-id="{{id}}"><img src="{{linkedItem.image}}" alt="{{linkedItem.name}}"><span>{{linkedItem.name}} · Open item sheet</span></button>{{else}}<p>{{linkedItem.name}}</p>{{/if}}{{else}}<span class="workshop-item-empty"><i class="fas fa-box"></i> Empty item slot</span>{{/if}}
            {{#if canLinkItem}}{{#if itemUuid}}<button type="button" data-workshop="clear-item" data-project-id="{{id}}">Remove item link</button>{{/if}}{{else}}<p>The GM or this project's Tech owner can change the link.</p>{{/if}}
          </div>{{/if}}{{#if sourceBlueprint}}<p>Source invention: {{sourceBlueprint}} (deleted from Workshop)</p>{{/if}}
          <div class="blueprint-grid"><div class="blueprint-image">{{#if image}}<img src="{{image}}" alt="{{name}} blueprint">{{else}}<span>BLUEPRINT IMAGE</span>{{/if}}</div><div><h4>Components / materials</h4><table><thead><tr><th>Component</th><th>Cost (eb)</th></tr></thead><tbody>{{#each components}}<tr><td>{{name}}</td><td>{{cost}}</td></tr>{{else}}<tr><td colspan="2">No materials recorded</td></tr>{{/each}}</tbody></table><strong>Total materials: {{totalCost}} eb</strong></div></div>
          <div class="blueprint-grid"><div><h4>Functions, rules & notes</h4><p class="blueprint-text">{{rules}}</p></div><div><h4>Special features & bonuses</h4><p class="blueprint-text">{{features}}</p></div></div>
          <label>Current attempt: {{done}} / {{target}}<progress value="{{percent}}" max="100">{{percent}}%</progress></label>
          <div class="workshop-toolbar">{{#if canEdit}}<button type="button" data-workshop="edit" data-project-id="{{id}}">Edit blueprint</button>{{/if}}{{#if gm}}{{#unless approved}}<button type="button" data-workshop="approve" data-project-id="{{id}}">Approve</button>{{/unless}}{{/if}}{{#if canResolve}}<button type="button" data-workshop="resolve" data-project-id="{{id}}">Record check outcome</button>{{/if}}{{#if canRetry}}<button type="button" data-workshop="retry" data-project-id="{{id}}">New attempt</button>{{/if}}{{#if canPrototype}}<button type="button" data-workshop="prototype" data-project-id="{{id}}">Create linked prototype</button>{{/if}}{{#if canReopen}}<button type="button" data-workshop="reopen" data-project-id="{{id}}">Reopen / correct</button>{{/if}}</div>
          {{#if gm}}<button type="button" class="workshop-delete" data-workshop="delete-project" data-project-id="{{id}}">Delete project</button>{{/if}}
          <details><summary>Attempt history</summary>{{#each attempts}}<p>Attempt {{number}}: {{status}} · {{work}} / {{target}} · DV {{dv}}{{#if resolved}} · Check {{total}} · {{notes}}{{/if}}</p>{{/each}}</details>
        </article>
      </details>
      {{else}}<p class="notice">No {{name}} yet. Create a project using the controls above.</p>{{/each}}
      </div></details>{{/each}}
      <details class="workshop-folder" data-workshop-folder="sessions" open><summary><i class="fas fa-folder"></i> Work Sessions <span>{{w.sessions.length}}</span></summary><div class="workshop-folder-body">
      {{#each w.sessions}}<div class="workshop-ledger"><strong>{{date}} · {{time}}{{#if voided}} · VOIDED{{/if}}</strong><p>{{projects}}</p><p>{{notes}}{{#if voided}} · Correction: {{voidReason}}{{/if}}</p>{{#if ../w.gm}}<button type="button" class="workshop-delete" data-workshop="delete-session" data-session-id="{{id}}">Delete work session</button>{{#unless voided}}<button type="button" data-workshop="void" data-session-id="{{id}}">Void / correct session</button>{{/unless}}{{/if}}</div>{{else}}<p>No work recorded yet.</p>{{/each}}</div></details>
      <details><summary>GM / request audit</summary>{{#each w.audit}}<p>{{date}} · {{action}} · {{userId}} {{reason}}</p>{{/each}}</details>
    </section>{{/if}}
    {{#unless editable}}<p class="notice">Shared crew record · Your GM manages purchases and edits.</p>{{/unless}}
    {{#unless s.access}}<p class="notice">ACCESS LOST — HQ benefits are suspended.</p>{{/unless}}
    {{#if s.workstationDebt}}<p class="notice">Restore the upgraded Workstation before other purchases.{{#if editable}} <button type="button" data-action="departure">Resolve Team Member departure</button>{{/if}}</p>{{/if}}
    <section class="tab" data-tab="info" data-group="hq">
    {{#if editable}}<div class="claim"><button type="button" data-action="claim"><i class="fas fa-flag"></i> Claim a place</button>
      <span class="hint">Pick the place's scene. The popup asks for the starting Improvement, starting HQ IP, rent and beds.</span></div>{{/if}}
    <fieldset {{#unless editable}}disabled{{/unless}}>
      <div class="fields"><label>Location<input name="location" value="{{s.location}}"></label><label>HQ scene<select name="sceneId" title="At-home bonuses apply while a crew token is in this scene and it is the active scene"><option value="">None</option>{{#each scenes}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select></label></div>
      <label>Description<textarea name="description" rows="2">{{s.description}}</textarea></label>
      <div class="fields three"><label>Monthly rent (eb)<input type="number" min="0" step="1" name="rent" value="{{s.rent}}"></label><label>Beds<input type="number" min="1" step="1" name="beds" value="{{s.beds}}" title="Rent Reduction upgrades add beds, up to double this"></label><label class="check"><input type="checkbox" name="access" {{checked s.access}}> Crew has access</label></div>
    </fieldset>
    <section class="stats three"><div><strong>{{s.ip}}</strong><span>Available HQ IP</span></div><div><strong>{{s.spent}}</strong><span>HQ IP spent so far</span></div><div><strong>{{b.monthlyRent}} eb</strong><span>Monthly rent</span></div></section>
    {{#if editable}}<div class="award"><input type="number" min="1" step="1" value="40" data-award aria-label="HQ IP award"><button type="button" data-action="award">Award HQ IP</button><span>Once per crew, equal to the mission's Group IP. Clears practice bonuses.</span></div>{{/if}}
    </section>
    <section class="tab" data-tab="crew" data-group="hq">
    <section class="hq-links"><h2>Crew <small>Six spaces · click a portrait to open its sheet</small></h2>
      <div class="crew-slots">{{#each assets.crew}}<div class="crew-slot" data-drop-zone="crew" data-slot="{{index}}">
        <button type="button" data-open="{{uuid}}" data-available="{{#if linked}}true{{else}}false{{/if}}" {{#unless linked}}disabled{{/unless}} title="{{name}}">
        {{#if image}}<img src="{{image}}" alt="{{name}} portrait">{{else}}<i class="fas fa-user"></i>{{/if}}<span>{{name}}</span></button>
        {{#if ../editable}}{{#if uuid}}<button type="button" class="unlink" data-asset-action="clear-crew" data-slot="{{index}}" title="Unlink crew sheet">×</button>{{/if}}{{/if}}
      </div>{{/each}}</div>
      <p class="hint">The whole crew lives here. Monthly rent <b>{{b.monthlyRent}}eb</b>, split evenly across the crew, paid from their own sheets. {{b.beds}} beds.</p>
      {{#if editable}}<div class="crew-ip-toolbar"><button type="button" data-crew-ip><i class="fas fa-star" aria-hidden="true"></i> Award crew IP</button><button type="button" data-crew-money><i class="fas fa-coins" aria-hidden="true"></i> Award crew money</button></div>{{/if}}
      <p class="hint">The GM can drag and drop character sheets from the Actors directory into the six crew slots. Click a portrait to open its sheet.</p>
      <div class="hq-utilities"><div class="garage-slot" data-drop-zone="garage"><h3>Garage</h3>
        <button type="button" data-open="{{assets.garage.uuid}}" data-available="{{#if assets.garage.linked}}true{{else}}false{{/if}}" {{#unless assets.garage.linked}}disabled{{/unless}}>
        {{#if assets.garage.image}}<img src="{{assets.garage.image}}" alt="Vehicle">{{else}}<i class="fas fa-car"></i>{{/if}}<span>{{assets.garage.name}}</span></button>
        {{#if editable}}<p class="hint">Drop a vehicle Item or vehicle Actor sheet here.</p>{{#if s.garageUuid}}<button type="button" data-asset-action="clear-garage">Unlink vehicle</button>{{/if}}{{/if}}
      </div><div class="shared-stash"><h3>Shared stash</h3>
        {{#if assets.stash}}<p><strong>{{assets.stash.balance}}eb</strong> · {{assets.stash.count}} item entries</p>
        <button type="button" data-open="{{s.stashUuid}}" data-available="true">Open item storage</button>
        <div class="stash-money"><button type="button" data-money="deposit" data-available="{{assets.stash.canTransfer}}" {{#unless assets.stash.canTransfer}}disabled{{/unless}}>Deposit eb</button><button type="button" data-money="withdraw" data-available="{{assets.stash.canTransfer}}" {{#unless assets.stash.canTransfer}}disabled{{/unless}}>Withdraw eb</button></div>
        <p class="hint">Store items by dragging them into the stash sheet. Retrieve using its item transfer controls and selected character.</p>
        {{else}}<p class="hint">{{#if assets.stashMissing}}The linked stash is missing.{{else}}The GM can create shared storage here.{{/if}}</p>{{/if}}
        {{#if editable}}{{#if s.stashUuid}}<button type="button" data-asset-action="sync-stash">Sync player access</button>{{/if}}{{#unless assets.stash}}<button type="button" data-asset-action="create-stash">Create shared stash</button>{{/unless}}{{/if}}
      </div></div>
    </section>
    </section>
    <section class="tab" data-tab="benefits" data-group="hq">
    <h2>Active crew benefits</h2>
    <p class="hint">Choose a character you own when using an action. Healing, Humanity and Hustle update that character automatically. Apply other conditional bonuses manually.</p>
    <div class="benefits">
    <div class="benefit-row"><p>Natural healing: <b>BODY +{{b.healing}}</b></p><button type="button" data-benefit="heal" {{#unless canUseBenefits}}disabled{{/unless}}><i class="fas fa-heart" aria-hidden="true"></i> Heal…</button></div>
    <p>LUCK increase: <b>+{{b.luck}}</b></p><div class="benefit-row"><p>Lifestyle saving: <b>{{b.lifestyle}}eb / member / month</b></p><button type="button" data-benefit="lifestyle" {{#unless canUseBenefits}}disabled{{/unless}}>Pay lifestyle…</button></div>
    <div class="benefit-row"><p>Monthly Humanity: <b>{{b.humanity}}</b></p><button type="button" data-benefit="humanity" {{#unless canRecoverHumanity}}disabled{{/unless}}><i class="fas fa-dice" aria-hidden="true"></i> Roll & restore…</button></div>
    <div class="benefit-row"><p>Hustle: <b>{{b.hustle}}</b></p><button type="button" data-benefit="hustle" {{#unless canUseBenefits}}disabled{{/unless}}><i class="fas fa-coins" aria-hidden="true"></i> Roll & earn…</button></div>
    {{#if s.improvements.training}}<div class="benefit-row"><p>Training Area: <b>+1</b> to one combat skill for a week of practice, until the next HQ IP award{{#if soloTwo}} (Solos: two skills){{/if}}</p><button type="button" data-benefit="practice" {{#unless canUseBenefits}}disabled{{/unless}}><i class="fas fa-dumbbell" aria-hidden="true"></i> Practice…</button></div>{{/if}}
    {{#each situational}}<p class="situational"><b>{{name}}</b>, while in the HQ scene: {{roles}} +{{bonus}} to {{skills}}.</p>{{/each}}
    {{#unless editable}}<p class="hint">Every button here asks the GM to approve before it changes a sheet.</p>{{/unless}}
    {{#if b.negotiation}}<p>Job pay: Fixers gain +2 Trading; non-Fixers can negotiate a 20% increase as Operator 5, without a Trading bonus.</p>{{/if}}
    {{#if b.custom}}<p>Morale upgrade 10: record the crew's GM-approved unique benefit in Notes.</p>{{/if}}</div>
    {{#if customBenefits}}<h3>Custom benefits <small>Apply effects manually</small></h3><div class="cards">{{#each customBenefits}}<article class="card owned"><h3>{{name}}</h3><p>{{base}}</p><ol>{{#each acquiredUpgrades}}<li>{{this}}</li>{{/each}}</ol></article>{{/each}}</div>{{/if}}
    <label>Notes / training expiry / projects / selected Team Member<textarea name="notes" rows="5" {{#unless editable}}disabled{{/unless}}>{{s.notes}}</textarea></label>
    </section>
    <section class="tab" data-tab="improvements" data-group="hq">
    <h2>Improvements & upgrades <small>{{s.purchaseCost}} HQ IP per purchase</small></h2>
    {{#if editable}}<label class="purchase-cost">Cost for every improvement or upgrade (HQ IP)<input type="number" name="purchaseCost" min="0" step="1" value="{{s.purchaseCost}}"><span class="hint">Default: 40. Applies to future purchases for this HQ; previous spending stays recorded at its original cost.</span></label>{{/if}}
    {{#if editable}}<button type="button" data-action="custom-add">Add custom improvement</button><p class="hint">Create a name, base benefit and ordered upgrade benefits. Custom purchases use the same HQ IP cost; apply their effects manually.</p>{{/if}}
    <table class="improvements"><thead><tr><th>Improvement</th><th>Base</th><th>Upgrade</th>{{#if editable}}<th></th>{{/if}}</tr></thead><tbody>
    {{#each cards}}<tr class="{{#if owned}}owned{{/if}}">
      <td><details><summary>{{name}}{{#if custom}} <small>custom</small>{{else}} <small>p. {{page}}</small>{{/if}}</summary>
        <p><b>Base.</b> {{base}}</p>{{#if custom}}<ol class="tiers">{{#each customUpgrades}}<li>{{this}}</li>{{else}}<li>No upgrades defined.</li>{{/each}}</ol>{{else}}<p><b>Upgrade.</b> {{upgrade}}</p>{{/if}}</details></td>
      <td class="cell">{{#if owned}}<span class="tick" title="Owned"><i class="fas fa-check"></i></span>{{else}}{{#if ../editable}}<button type="button" data-action="buy" data-id="{{id}}" {{#unless canBuyBase}}disabled title="{{error}}"{{/unless}}>Buy · {{../s.purchaseCost}}</button>{{else}}<span class="dash">–</span>{{/if}}{{/if}}</td>
      <td class="cell">{{#if noUpgrade}}<span class="dash">–</span>{{else}}{{#if upgradeDone}}<span class="tick" title="Fully upgraded"><i class="fas fa-check"></i>{{#if multi}} {{upgradeLabel}}{{/if}}</span>{{else}}{{#if multi}}<span class="count">{{upgradeLabel}}</span>{{/if}}{{#if ../editable}}<button type="button" data-action="buy" data-id="{{id}}" {{#unless canBuyUpgrade}}disabled title="{{#if owned}}{{error}}{{else}}Buy the base first{{/if}}"{{/unless}}>{{#if multi}}+1{{else}}Buy{{/if}} · {{../s.purchaseCost}}</button>{{else}}{{#unless multi}}<span class="dash">–</span>{{/unless}}{{/if}}{{/if}}{{/if}}</td>
      {{#if ../editable}}<td class="cell tools">{{#if owned}}<button type="button" class="loss" data-action="lose" data-id="{{id}}" title="Remove without refund">Lost</button>{{/if}}{{#if custom}}<button type="button" data-action="custom-edit" data-id="{{id}}" title="Edit"><i class="fas fa-pen"></i></button><button type="button" data-action="custom-delete" data-id="{{id}}" title="Delete"><i class="fas fa-trash"></i></button>{{/if}}</td>{{/if}}
    </tr>{{/each}}</tbody></table>
    </section>
    <section class="tab" data-tab="activity" data-group="hq">
    <h2>Recent activity</h2><ol class="log">{{#each log}}<li><b>{{label}}</b><br><small>{{date}} · {{user}}</small></li>{{else}}<li>No purchases or awards yet.</li>{{/each}}</ol>
    {{#if editable}}<button type="button" data-action="destroy" class="destroy">Record HQ destruction</button>{{/if}}
    <p class="source">NuNu private build on SleepingM4n's No Place Like Home module. Rules from R. Talsorian Games' No Place Like Home (2024).</p>
    </section>
  </main>
</form>
